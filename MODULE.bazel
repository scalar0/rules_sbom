module(
    name = "rules_sbom",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "jq.bzl", version = "0.7.1")
bazel_dep(name = "toml.bzl", version = "0.5.0")
bazel_dep(name = "rules_python", version = "2.4.2")

bazel_dep(
    name = "bazel_skylib",
    version = "1.9.2",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_uv",
    version = "0.89.2",
    dev_dependency = True,
)
bazel_dep(
    name = "stardoc",
    version = "0.8.1",
    dev_dependency = True,
)

syft = use_extension("//:extensions.bzl", "syft")
use_repo(
    syft,
    "syft_darwin_amd64",
    "syft_darwin_arm64",
    "syft_linux_amd64",
    "syft_linux_arm64",
)

register_toolchains("//toolchains:all")

jq = use_extension("@jq.bzl//jq:extensions.bzl", "toolchains")
use_repo(jq, "jq_toolchains")

register_toolchains(
    "@jq_toolchains//:all",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14.4")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "cargo_license_deps",
    python_version = "3.14.4",
    requirements_lock = "//private:requirements.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
        "osx_x86_64",
        "osx_aarch64",
    ],
)
use_repo(pip, "cargo_license_deps")

cargo_fixtures = use_extension(
    "//tests:repositories.bzl",
    "fixtures",
    dev_dependency = True,
)
use_repo(cargo_fixtures, "cargo_fixture_licenses")

local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "local_repository",
)

local_repository(
    name = "sbom_test_inputs",
    dev_dependency = True,
    path = "tests/external",
)

bazel_dep(
    name = "bazel_lib",
    version = "3.7.2",
    dev_dependency = True,
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "10.1.0",
    dev_dependency = True,
)

# Validation actions execute the pinned binary without a host shell launcher.
buildifier_tools = use_extension(
    "@buildifier_prebuilt//:defs.bzl",
    "buildifier_prebuilt_deps_extension",
    dev_dependency = True,
)
use_repo(buildifier_tools, "buildifier_linux_amd64")

bazel_dep(
    name = "aspect_rules_lint",
    version = "2.9.1",
    dev_dependency = True,
)
bazel_dep(
    name = "aspect_rules_js",
    version = "3.5.1",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_nodejs",
    version = "6.7.6",
    dev_dependency = True,
)

node = use_extension(
    "@rules_nodejs//nodejs:extensions.bzl",
    "node",
    dev_dependency = True,
)
node.toolchain(node_version = "22.23.3")
use_repo(node, "nodejs_toolchains")

register_toolchains(
    "@nodejs_toolchains//:all",
    dev_dependency = True,
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "prettier",
    build_file_content = '''load("@aspect_rules_js//js:defs.bzl", "js_binary")
js_binary(
    name = "prettier",
    entry_point = "bin/prettier.cjs",
    env = {"BAZEL_BINDIR": "."},
    data = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
''',
    dev_dependency = True,
    integrity = "sha512-skGHTH1Yb9QvaTC4hWnRTzEYtCpApF0UMBPz+t/0ZPzP8ihefo/btKd+QA7pUE0fEwA1SbS/NmhyEcstdXOIdA==",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/prettier/-/prettier-3.9.10.tgz"],
)

# Older transitive Go rules use CcInfo, which Bazel 9 removed.
bazel_dep(
    name = "rules_go",
    version = "0.64.2",
    dev_dependency = True,
    repo_name = None,
)

# Documentation generation needs a pinned C++ compiler and linker.
bazel_dep(
    name = "llvm",
    version = "0.8.24",
    dev_dependency = True,
)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
